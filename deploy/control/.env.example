# Nexus Control stack settings (NEX-108). Run deploy/control/scripts/install.sh (or install.ps1):
# it creates deploy/control/.env (git-ignored) and fills every empty secret with a random value (never printed).
# Never commit deploy/control/.env or deploy/control/.env.vault-init.json.

# Runtime & public URLs (leave empty for local defaults; set https:// URLs behind your reverse proxy in prod)
NEXUS_CONTROL_ENVIRONMENT=
NEXUS_CONTROL_PORT=
NEXUS_CONTROL_API_PUBLIC_URL=
NEXUS_CONTROL_APP_PUBLIC_URL=
NEXUS_CONTROL_KEYCLOAK_PUBLIC_URL=
NEXUS_CONTROL_LAGO_WEBHOOK_URL=
NEXUS_IMAGE_API=
NEXUS_CONTROL_DEMO=

# Control database & staff Keycloak secrets (generated once by the install script)
NEXUS_CONTROL_DB_PASSWORD=
NEXUS_CONTROL_APP_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
NEXUS_KEYCLOAK_ADMIN_PASSWORD=
NEXUS_CONTROL_OIDC_CLIENT_SECRET=
NEXUS_DEMO_USER_PASSWORD=

# OpenBao Transit app token (created & renewed by the install script)
NEXUS_VAULT_TOKEN=

# Lago billing engine secrets (generated once by the install script; webhook key synced from Lago)
LAGO_DB_PASSWORD=
LAGO_SECRET_KEY_BASE=
LAGO_RSA_PRIVATE_KEY=
LAGO_ENCRYPTION_PRIMARY_KEY=
LAGO_ENCRYPTION_DETERMINISTIC_KEY=
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=
LAGO_ORG_USER_PASSWORD=
NEXUS_CONTROL_LAGO_API_KEY=
NEXUS_CONTROL_LAGO_WEBHOOK_KEY=

# Razorpay payment gateway for Indian accounts (NEX-107, Nexus Control). Test mode in dev: the key id starts with
# `rzp_test_`. Razorpay Dashboard (Test Mode) → Account & Settings → API Keys: key id + key secret; → Webhooks: the
# secret you set on the webhook. Live keys only in the production secret store — never in a file in git.
NEXUS_CONTROL_RAZORPAY_KEY_ID=
NEXUS_CONTROL_RAZORPAY_KEY_SECRET=
NEXUS_CONTROL_RAZORPAY_WEBHOOK_SECRET=
