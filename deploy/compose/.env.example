# NexusCampus self-hosted install settings (NEX-064). The install script copies this to .env (git-ignored) and
# fills every `generate` value with a random secret. Never commit a filled-in .env.

# Where people open NexusCampus (your reverse proxy's https:// address in production).
NEXUS_PUBLIC_URL=http://127.0.0.1:8088
# Where browsers reach Keycloak's sign-in pages.
NEXUS_KEYCLOAK_PUBLIC_URL=http://127.0.0.1:8089
NEXUS_WEB_PORT=8088
NEXUS_KEYCLOAK_PORT=8089
# Data region of this cell (D45): in | eu.
NEXUS_REGION=in

# Secrets (generated on first install).
NEXUS_DB_PASSWORD=generate
NEXUS_APP_DB_PASSWORD=generate
KEYCLOAK_DB_PASSWORD=generate
NEXUS_KEYCLOAK_ADMIN_PASSWORD=generate
NEXUS_OIDC_CLIENT_SECRET=generate
NEXUS_GRANT_SIGNING_KEY=generate
# Written by the install script: a Vault token that may only use the Transit engine.
NEXUS_VAULT_TOKEN=

# AI gateway (D24): fake (no model) | anthropic (set the key) | bedrock (AWS credentials from the environment).
NEXUS_AI_PROVIDER=fake
NEXUS_ANTHROPIC_API_KEY=

# Images: local builds by default; pin released images by digest, e.g. registry/nexuscampus-api@sha256:…
NEXUS_IMAGE_API=nexuscampus-api:dev
NEXUS_IMAGE_WEB=nexuscampus-web:dev

# Demo data: set to `demo` for the demo institutions and users (password below), empty for an empty install.
NEXUS_SEED=
NEXUS_DEMO_USER_PASSWORD=generate
