{
  "name": "@nexus/ui-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contrast": "./src/theme/contrast.ts",
    "./styles.css": "./src/theme/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/build-tokens.ts --check && eslint -c ../../eslint.config.js --cache --cache-location node_modules/.cache/eslint/ . && node scripts/check-classes.ts .",
    "tokens": "node scripts/build-tokens.ts",
    "test": "node ../../scripts/time-run.ts test:pkg --label test:ui-core -- vitest run"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/noto-sans-tamil": "5.3.0",
    "@nexus/i18n": "workspace:*",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "jsdom": "26.1.0",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  }
}
