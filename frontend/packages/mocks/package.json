{
  "name": "@nexus/mocks",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint -c ../../eslint.config.js --cache --cache-location node_modules/.cache/eslint/ .",
    "test": "node ../../scripts/time-run.ts test:pkg --label test:mocks -- vitest run",
    "export:fixtures": "node scripts/export-fixtures.ts"
  },
  "dependencies": {
    "@nexus/contracts": "workspace:*",
    "@nexus/i18n": "workspace:*",
    "@nexus/ui-core": "workspace:*",
    "msw": "3.0.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  }
}
