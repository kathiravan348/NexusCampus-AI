{
  "name": "nexus-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter campus dev",
    "dev:real": "pnpm --filter campus dev:real",
    "dev:control": "pnpm --filter control dev",
    "storybook": "pnpm --filter @nexus/ui-storybook dev",
    "build": "node scripts/time-run.ts build:all -- pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "node scripts/time-run.ts check:test --label test -- vitest run",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "check:lint": "node scripts/time-run.ts check:lint --sequence lint lint:scripts",
    "check:typecheck": "node scripts/time-run.ts check:typecheck --sequence typecheck typecheck:scripts",
    "check:test": "node scripts/time-run.ts check:test -- vitest run",
    "check:format": "node scripts/time-run.ts check:format -- prettier --check --cache .",
    "review:check": "node scripts/time-run.ts review:check --sequence check:format check:lint check:typecheck check:test build:all=build",
    "lint:scripts": "eslint --cache --cache-location node_modules/.cache/eslint/ scripts e2e",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "timings:measure": "node scripts/measure-timings.ts",
    "review:start": "pnpm --filter campus run review:start",
    "e2e": "node scripts/time-run.ts e2e -- playwright test -c e2e/playwright.config.ts",
    "e2e:real": "playwright test -c e2e/real/playwright.config.ts",
    "manual": "playwright test -c e2e/manual/playwright.config.ts && node scripts/build-manual.ts",
    "manual:build": "node scripts/build-manual.ts",
    "texts:export": "node scripts/texts-export.ts",
    "texts:import": "node scripts/texts-import.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.12.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.70.1",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
