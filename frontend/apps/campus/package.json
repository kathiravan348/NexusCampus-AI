{
  "name": "campus",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/time-run.ts dev:campus --ready-pattern Local: -- vite",
    "dev:real": "node ../../scripts/time-run.ts dev:campus --ready-pattern Local: -- vite --mode real",
    "build": "node ../../scripts/time-run.ts build:campus -- vite build",
    "preview": "node ../../scripts/time-run.ts preview:campus --ready-pattern Local: -- vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/sw",
    "test": "node ../../scripts/time-run.ts test:pkg --label test:campus -- vitest run",
    "lint": "eslint -c ../../eslint.config.js --cache --cache-location node_modules/.cache/eslint/ .",
    "review:build": "vite build --mode review",
    "review:preview": "node ../../scripts/time-run.ts preview:campus --ready-pattern Local: -- vite preview --mode review --open",
    "review:start": "node ../../scripts/time-run.ts review:start --sequence build:campus=review:build review:preview"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.2",
    "@nexus/contracts": "workspace:*",
    "@nexus/i18n": "workspace:*",
    "@nexus/offline": "workspace:*",
    "@nexus/services": "workspace:*",
    "@nexus/ui-core": "workspace:*",
    "@nexus/ui-edu": "workspace:*",
    "lucide-react": "1.47.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "7.18.5",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@nexus/mocks": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "26.1.0",
    "msw": "3.0.7",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "3.2.7"
  }
}
