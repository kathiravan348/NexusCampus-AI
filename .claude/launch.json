{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "campus",
      "runtimeExecutable": "fnm",
      "runtimeArgs": [
        "exec",
        "--using=24",
        "--",
        "pnpm",
        "--dir",
        "frontend",
        "dev"
      ],
      "port": 3100
    },
    {
      "name": "storybook",
      "runtimeExecutable": "fnm",
      "runtimeArgs": [
        "exec",
        "--using=24",
        "--",
        "pnpm",
        "--dir",
        "frontend/packages/ui-storybook",
        "dev",
        "--no-open"
      ],
      "port": 6006
    },
    {
      "name": "campus-real",
      "runtimeExecutable": "fnm",
      "runtimeArgs": [
        "exec",
        "--using=24",
        "--",
        "pnpm",
        "--dir",
        "frontend",
        "dev:real"
      ],
      "port": 3100
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--project",
        "backend",
        "nexus-dev"
      ],
      "port": 8000
    },
    {
      "name": "campus-real-built",
      "runtimeExecutable": "fnm",
      "runtimeArgs": [
        "exec",
        "--using=24",
        "--",
        "pnpm",
        "--dir",
        "frontend/apps/campus",
        "real:preview"
      ],
      "port": 3101,
      "autoPort": false
    }
  ]
}
