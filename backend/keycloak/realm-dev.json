{
  "realm": "nexus-dev",
  "displayName": "NexusCampus (dev cell)",
  "enabled": true,
  "organizationsEnabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "hi",
    "ta"
  ],
  "defaultLocale": "en",
  "clients": [
    {
      "clientId": "nexus-backend",
      "name": "NexusCampus API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${NEXUS_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "http://127.0.0.1:8000/api/v1/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:3100"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:3100/*"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "organization"
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-nexus-backend",
      "enabled": true,
      "serviceAccountClientId": "nexus-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "manage-realm",
          "view-realm"
        ]
      }
    }
  ]
}
