# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
NEXUS_ENVIRONMENT=dev
NEXUS_REGION=in
# Owner password for the Compose PostgreSQL (used by migrations and the demo seed only).
NEXUS_DB_PASSWORD=change-me
NEXUS_MIGRATE_DATABASE_URL=postgresql+psycopg://nexus:change-me@127.0.0.1:55432/nexus
# The app connects as nexus_app (no BYPASSRLS); the baseline migration sets this password.
NEXUS_APP_DB_PASSWORD=change-me-too
NEXUS_DATABASE_URL=postgresql+psycopg://nexus_app:change-me-too@127.0.0.1:55432/nexus
NEXUS_REDIS_URL=redis://127.0.0.1:56379/0
NEXUS_OTEL_EXPORTER=none
# Sign-in (D44): the backend's Keycloak client secret, the dev Keycloak admin password, and the password the
# dev script gives every demo user (nexus-keycloak-dev). Dev values only.
NEXUS_OIDC_CLIENT_SECRET=change-me-secret
NEXUS_KEYCLOAK_ADMIN_PASSWORD=change-me-admin
NEXUS_DEMO_USER_PASSWORD=change-me-demo
